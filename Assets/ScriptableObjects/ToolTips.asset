%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f7852bcc0f5a427418319765b7ad5c1b, type: 3}
  m_Name: ToolTips
  m_EditorClassIdentifier: Assembly-CSharp::ToolTipsSO
  Data:
  - word: bleeding
    wordColor: {r: 1, g: 0.29411766, b: 0.29411766, a: 1}
    toolTip: Bleeding stacks deal 10 damage every turn until healed.
    width: 500
    height: 100
  - word: burning
    wordColor: {r: 1, g: 0.29411766, b: 0.29411766, a: 1}
    toolTip: Burning stacks deal 10 damage every turn for a set duration of turns.
    width: 500
    height: 100
  - word: weakened
    wordColor: {r: 1, g: 0.29411766, b: 0.29411766, a: 1}
    toolTip: Weakened causes the target to deal less damage for a set duration of
      turns.
    width: 500
    height: 100
  - word: vulnerable
    wordColor: {r: 1, g: 0.29411766, b: 0.29411766, a: 1}
    toolTip: Vulnerable causes the target to take more damage for a set duration
      of turns.
    width: 500
    height: 100
  - word: broken
    wordColor: {r: 1, g: 0.29411766, b: 0.29411766, a: 1}
    toolTip: Broken causes the target to have healing reduction for a set duration
      of turns.
    width: 500
    height: 150
  - word: empowered
    wordColor: {r: 1, g: 0.29411766, b: 0.29411766, a: 1}
    toolTip: Empowered causes the target to deal more damage for a set duration of
      turns.
    width: 500
    height: 100
  - word: cleanses
    wordColor: {r: 1, g: 0.29411766, b: 0.29411766, a: 1}
    toolTip: Removes all negative status effects.
    width: 500
    height: 100
  - word: speed
    wordColor: {r: 1, g: 0.29411766, b: 0.29411766, a: 1}
    toolTip: Speed causes the next attack animation of the target to be faster.
    width: 500
    height: 100
  - word: slow
    wordColor: {r: 1, g: 0.29411766, b: 0.29411766, a: 1}
    toolTip: Slow causes the next attack animation of the target to be slower.
    width: 500
    height: 100
